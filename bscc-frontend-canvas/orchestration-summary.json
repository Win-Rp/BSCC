    "styleDefinitionBrief": "标书查重平台画布版，采用黑白灰主导的极简审计风，强调流程、证据与运营可读性，方便后续在画布中继续调整。",
    "designRead": "标书查重工作台 / 投标团队与运营人员 / 克制审计感 / 中高密度 / 避免花哨渐变和营销化装饰",
    "designDials": {
      "layoutVariance": 2,
      "motionIntensity": 1,
      "visualDensity": 4
    },
    "styleContinuityAnchors": {
      "colorSystem": "以黑白灰单主色体系为核心，主按钮与选中态使用炭黑色，风险信息仅通过语义状态色表达，不使用额外品牌强调色。",
      "shapeSystem": "卡片、表格、输入框统一使用 4/8/12px 的克制圆角，边框细而清晰，不使用夸张软圆角。",
      "typographySystem": "中文界面统一使用无衬线字体层级，标题偏紧凑，正文高可读，编号与任务号使用等宽风格强化审计感。",
      "spacingSystem": "页面采用宽边距与规则栅格，模块内 12/16/24 的递进间距，信息密集区优先通过分区而非装饰区分。",
      "componentLanguage": "优先使用标题条、指标卡、规则说明、数据表、状态条、左右对照区等运营与审计型组件语言。",
      "surfaceAndDepth": "静态模块以白底、浅灰底与细边框分层，普通卡片阴影极弱，仅弹窗类浮层可使用更深阴影。",
      "imageryAndIconography": "本项目以信息界面为主，不依赖图片，图形语言采用线性图标、流程编号、风险标签和表格。",
      "interactionTone": "交互反馈直接、稳定、克制，以选中边框、背景明度变化和进度状态为主，不使用炫技动效。"
    },
    "specsConstraints": null,
    "sharedProjectShellContract": {
      "navigationShell": "所有页面共享顶部标题区与横向导航，导航项使用统一的细边框胶囊形态，当前页通过深色底反白显示。",
      "primaryColorSystem": "单一主色为炭黑，辅助通过浅灰底与边框层级表达，不引入 secondary 或 accent 品牌色。",
      "typographySystem": "标题使用统一中文无衬线层级，正文 14px 为主，标签 12px，关键编号和任务号使用等宽字体。",
      "radiusScale": "共享 4/8/12px 圆角体系，最大不超过 12px。",
      "surfaceDepthModel": "白底卡片+浅灰分区+细边框为主，普通卡片阴影 alpha <= 0.04。",
      "ctaStyle": "主按钮为深色实底浅字，次按钮为白底描边，尺寸统一紧凑。",
      "alignmentRules": "页面主栅格以左对齐为主，表格和指标行采用严格基线对齐，避免视觉漂移。"
    },
