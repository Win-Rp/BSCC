<view class="unlock-card" wx:if="{{viewModel}}">
  <block wx:if="{{viewModel.locked}}">
    <view class="unlock-card__head">
      <view class="unlock-card__title">解锁查重</view>
      <text class="unlock-card__badge" wx:if="{{viewModel.badge}}">{{viewModel.badge}}</text>
    </view>
    <view class="unlock-card__desc">{{viewModel.desc}}</view>

    <view class="unlock-card__price">
      <text class="unlock-card__price-value">{{viewModel.priceText}}</text>
      <text class="unlock-card__price-strike" wx:if="{{viewModel.strikeText}}">原价 {{viewModel.strikeText}}</text>
      <text class="unlock-card__price-save" wx:if="{{viewModel.savingsText}}">立省 {{viewModel.savingsText}}</text>
    </view>
    <view class="unlock-card__unit" wx:if="{{viewModel.unitPriceText}}">{{viewModel.unitPriceText}} · 共 {{viewModel.bFileCount}} 份对比文件</view>

    <view class="unlock-card__countdown" wx:if="{{viewModel.showCountdown && countdownText}}">
      <text class="unlock-card__countdown-label">距优惠结束</text>
      <text class="unlock-card__countdown-value">{{countdownText}}</text>
    </view>

    <view class="unlock-card__note" wx:if="{{viewModel.note}}">{{viewModel.note}}</view>
    <view class="unlock-card__note unlock-card__note--loss" wx:if="{{viewModel.lossAversion}}">{{viewModel.lossAversion}}</view>

    <button class="btn-primary unlock-card__button" bindtap="handleUnlock">
      解锁查重 · {{viewModel.priceText}}
    </button>
    <view class="unlock-card__meta">对比文件数：{{viewModel.bFileCount}}<text wx:if="{{orderNo}}"> ｜订单号：{{orderNo}}</text></view>
  </block>

  <block wx:else>
    <view class="unlock-card__head">
      <view class="unlock-card__title">{{viewModel.title}}</view>
    </view>
    <view class="unlock-card__desc">{{viewModel.desc}}</view>
    <view class="unlock-card__meta">对比文件数：{{viewModel.bFileCount}}<text wx:if="{{orderNo}}"> ｜订单号：{{orderNo}}</text></view>
    <button class="btn-secondary unlock-card__button" bindtap="handleView">查看完整详情</button>
  </block>
</view>
