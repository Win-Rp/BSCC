.nav-bar {
  box-sizing: border-box;
  margin: -24rpx -24rpx 0;
  position: relative;
  z-index: 100;
}

.nav-bar__body {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  position: relative;
}

.nav-bar__side {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.nav-bar__back {
  width: 64rpx;
  height: 64rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-bar__back--hover {
  background: rgba(18, 110, 106, 0.08);
}

.nav-bar__back-icon {
  font-size: 56rpx;
  color: #1f2933;
  line-height: 1;
  font-weight: 300;
  margin-top: -6rpx;
}

.nav-bar__title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  max-width: 60%;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2933;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
