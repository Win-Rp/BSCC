.docs-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 60rpx;
}

/* 顶部介绍 */
.docs-hero {
  background: linear-gradient(160deg, #0b4f4c 0%, #126e6a 55%, #1b8a83 100%);
  border: none;
  color: #ffffff;
}

.docs-hero__logo {
  width: 340rpx;
  height: auto;
  margin-bottom: 28rpx;
  display: block;
}

.docs-hero__title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.docs-hero__desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.88);
  margin-bottom: 20rpx;
}

.docs-hero__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.docs-hero .tag {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

/* 目录锚点 */
.docs-anchor {
  white-space: nowrap;
}

.docs-anchor__list {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx;
}

.docs-anchor__item {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #dde3e7;
  color: #68727d;
  font-size: 24rpx;
}

.docs-anchor__item--active {
  background: #126e6a;
  border-color: #126e6a;
  color: #ffffff;
  font-weight: 600;
}

/* 区块 */
.docs-section {
  scroll-margin-top: 20rpx;
}

.docs-grid {
  display: grid;
  gap: 16rpx;
}

.docs-grid--two {
  grid-template-columns: repeat(2, 1fr);
}

.docs-grid--three {
  grid-template-columns: repeat(3, 1fr);
}

.docs-mini-card {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f7fafb;
  border: 1rpx solid #e8eef1;
}

.docs-mini-card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2933;
  margin-bottom: 8rpx;
}

.docs-mini-card__text {
  font-size: 23rpx;
  color: #68727d;
  line-height: 1.65;
}

/* 步骤 */
.docs-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.docs-step {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7fafb;
  border: 1rpx solid #e8eef1;
}

.docs-step__index {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #0b4f4c;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.docs-step__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2933;
}

.docs-step__desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #68727d;
  line-height: 1.65;
}

/* 提示条 */
.docs-tip-strip {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.docs-tip {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #eff8fb;
  border: 1rpx solid #cde7f1;
}

.docs-tip__title {
  font-size: 24rpx;
  font-weight: 600;
  color: #155e75;
  margin-bottom: 4rpx;
}

.docs-tip__text {
  font-size: 23rpx;
  color: #4a6b77;
  line-height: 1.6;
}

/* 高亮卡 */
.docs-highlight {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(17, 17, 17, 0.03);
  border: 1rpx solid #e8eef1;
  margin-bottom: 14rpx;
}

.docs-highlight--warn {
  background: #fff7ed;
  border-color: #fde3c1;
}

.docs-highlight__title {
  font-size: 25rpx;
  font-weight: 600;
  color: #1f2933;
  margin-bottom: 6rpx;
}

.docs-highlight--warn .docs-highlight__title {
  color: #9a5b13;
}

.docs-highlight__text {
  font-size: 23rpx;
  color: #68727d;
  line-height: 1.65;
}

/* 找回提示 */
.docs-recover-tip {
  margin-bottom: 18rpx;
}

/* FAQ 手风琴 */
.docs-faq {
  border: 1rpx solid #e8eef1;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.docs-faq__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 22rpx;
}

.docs-faq__q {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2933;
}

.docs-faq__arrow {
  flex: none;
  color: #98a2ad;
  font-size: 24rpx;
  transition: transform 0.2s ease;
}

.docs-faq__arrow--open {
  transform: rotate(180deg);
  color: #126e6a;
}

.docs-faq__a {
  padding: 0 22rpx 20rpx;
  font-size: 24rpx;
  color: #68727d;
  line-height: 1.7;
  background: #fbfcfd;
}

/* 返回按钮 */
.docs-back {
  margin-top: 10rpx;
}
