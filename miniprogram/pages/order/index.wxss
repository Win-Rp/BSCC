.order-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.task-line,
.order-line {
  margin-top: 12rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field + .field {
  margin-top: 20rpx;
}

.field__label {
  margin-bottom: 10rpx;
  color: #68727d;
  font-size: 24rpx;
}

.channel-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.channel-item + .channel-item {
  margin-top: 12rpx;
}

.create-btn {
  width: 100%;
  margin-top: 24rpx;
}

.order-copy-btn {
  flex-shrink: 0;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.step-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.step-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
  color: #126e6a;
  background: #edf8f7;
}

.step-text {
  flex: 1;
  color: #44515c;
  font-size: 26rpx;
}

.qr-image {
  width: 360rpx;
  height: 360rpx;
  margin: 20rpx auto;
  display: block;
  border-radius: 18rpx;
  background: #f7fafb;
}

.qr-empty {
  margin: 20rpx 0;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f7fafb;
  color: #68727d;
  font-size: 24rpx;
}

.status-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.status-actions button {
  flex: 1;
}

/* 促销定价卡片 */
.pricing-card {
  background: linear-gradient(180deg, #ffffff 0%, #fdf9f2 100%);
  border: 1rpx solid #f5e2c0;
}

.pricing-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.pricing-card__head .section-title {
  margin-bottom: 0;
}

.pricing-card__amount {
  padding: 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid #f0e2c8;
}

.pricing-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pricing-card__price {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.1;
}

.pricing-card__save-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(18, 110, 106, 0.1);
  color: #126e6a;
  font-size: 22rpx;
  font-weight: 600;
}

.pricing-card__meta {
  margin-top: 12rpx;
  color: #68727d;
  font-size: 23rpx;
}

.pricing-card__countdown {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff1e6;
  border: 1rpx solid #ffd7b8;
}

.pricing-card__countdown-label {
  color: #9a5b13;
  font-size: 24rpx;
}

.pricing-card__countdown-value {
  font-family: monospace;
  font-size: 32rpx;
  font-weight: 800;
  color: #f04b2a;
  letter-spacing: 2rpx;
}

.pricing-card__countdown-loss {
  flex: 1;
  text-align: right;
  color: #b06a1f;
  font-size: 22rpx;
}

.pricing-card__note {
  margin-top: 14rpx;
  color: #9a5b13;
  font-size: 23rpx;
  line-height: 1.6;
}

.pricing-card__note--loss {
  color: #d97706;
  font-weight: 600;
}
