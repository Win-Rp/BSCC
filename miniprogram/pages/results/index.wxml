<view class="page results-page">
  <nav-bar title="查重结果" showBack />

  <view class="card" wx:if="{{summaryMeta}}">
    <view class="task-head-row">
      <view class="task-id-box" bindtap="copyTaskNo">
        <text class="task-id-box__text">{{summaryMeta.taskNo}}</text>
        <text class="task-id-box__copy">复制任务号</text>
      </view>
      <button class="share-btn" open-type="share" aria-label="分享查重结果给微信好友">
        <view class="share-btn__icon">
          <view class="share-btn__arrow"></view>
          <view class="share-btn__base"></view>
        </view>
        <text class="share-btn__text">分享结果</text>
      </button>
    </view>
    <view class="meta-chips">
      <text class="meta-chip">{{summaryMeta.modeText}}</text>
      <text class="meta-chip">B 文件 {{summaryMeta.bFileCount}} 份</text>
      <text class="meta-chip {{isUnlocked ? 'meta-chip--safe' : 'meta-chip--warn'}}">{{summaryMeta.unlockText}}</text>
      <text class="meta-chip">保留至 {{summaryMeta.expiresAt}}</text>
    </view>
    <view class="file-line">
      <view class="file-badge file-badge--a">A</view>
      <text class="file-line__name">{{summaryMeta.aFileName}}</text>
    </view>
    <view class="file-line">
      <view class="file-badge file-badge--b">B</view>
      <text class="file-line__name">{{summaryMeta.selectedBFileName}}</text>
    </view>
  </view>

  <unlock-bar
    wx:if="{{summary}}"
    summary="{{summary}}"
    unlocked="{{isUnlocked}}"
    orderNo="{{orderNo}}"
    promo="{{promoConfig}}"
    bind:unlock="gotoOrder"
    bind:view="gotoCompare"
  />

  <view class="card" wx:if="{{overviewData.totalMetric}}">
    <view class="section-title">相似度指标</view>
    <view class="metric-hero">
      <view class="metric-hero__score metric-hero__score--{{overviewData.totalMetric.riskType}}">
        {{overviewData.totalMetric.valueText}}
      </view>
      <view class="metric-hero__side">
        <text class="tag tag-{{overviewData.totalMetric.riskType}}">{{overviewData.totalMetric.riskText}}</text>
        <view class="metric-hero__hint">A 与当前 B 的总相似度</view>
      </view>
    </view>
    <view class="overview-bars">
      <view class="bar-row" wx:for="{{overviewData.details}}" wx:key="label">
        <text class="bar-row__label">{{item.label}}</text>
        <view class="bar-row__track">
          <view class="bar-row__fill {{item.fillClass}}" style="width: {{item.percent}}%;"></view>
        </view>
        <text class="bar-row__value">{{item.value}}</text>
      </view>
    </view>
    <view class="overview-note">格式相似、元数据相似反映文档结构与属性层面的接近程度，不等同于内容重复。</view>
  </view>

  <view class="card">
    <view class="section-title">结果列表</view>
    <view class="empty" wx:if="{{!loading && (!summary || !summary.results || !summary.results.length)}}">暂无结果，请稍后刷新。</view>
    <view class="result-list" wx:if="{{summary && summary.results && summary.results.length}}">
      <result-card
        wx:for="{{summary.results}}"
        wx:key="compare_result_id"
        result="{{item}}"
        selected="{{item.compare_result_id === selectedResultId}}"
        locked="{{summary.payment_required && !isUnlocked}}"
        unlocked="{{isUnlocked}}"
        bind:preview="handlePreview"
        bind:detail="handleDetail"
        bind:unlock="gotoOrder"
      />
    </view>
  </view>

  <view class="card">
    <view class="section-title">免费预览</view>
    <view class="muted" wx:if="{{previewLoading}}">正在加载预览片段…</view>
    <view class="empty" wx:if="{{!previewLoading && !previewList.length}}">当前结果暂无可展示的预览片段。</view>
    <view class="preview-list" wx:if="{{previewList.length}}">
      <view class="preview-item" wx:for="{{previewList}}" wx:key="id">
        <view class="preview-item__meta">
          <text class="tag {{item.typeClass}}">{{item.typeText}}</text>
          <text class="preview-item__ratio">{{item.similarityText}}</text>
        </view>
        <view class="preview-item__block preview-item__block--a">
          <view class="preview-item__label">A</view>
          <text class="preview-item__text">{{item.aText}}</text>
        </view>
        <view class="preview-item__block preview-item__block--b">
          <view class="preview-item__label">B</view>
          <text class="preview-item__text">{{item.bText}}</text>
        </view>
        <view class="preview-item__pos">
          <text class="preview-item__pos-chip">A · 第 {{item.aPage}} 页</text>
          <text class="preview-item__pos-chip">B · 第 {{item.bPage}} 页</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{summary}}">
    <view class="section-title">{{isUnlocked ? '查看完整详情' : '预览与原文'}}</view>
    <view class="section-desc">
      {{isUnlocked ? '结果已解锁，进入对比页可查看全部重复片段与差异定位。' : '结果未解锁，可打开原文或进入对比页查看免费预览片段。'}}
    </view>
    <view class="result-actions">
      <button class="btn-primary compare-cta" bindtap="gotoCompare" disabled="{{!selectedResultId}}">
        {{isUnlocked ? '进入对比页查看完整详情' : '进入对比页（预览模式）'}}
      </button>
      <view class="result-actions-row">
        <button class="btn-secondary" bindtap="handleOpenAFile">打开 A 原文</button>
        <button class="btn-secondary" bindtap="handleOpenBFile" disabled="{{!selectedResultId}}">打开 B 原文</button>
      </view>
    </view>
  </view>

  <view class="footer-link" wx:if="{{summary}}" bindtap="gotoRecovery">找回历史任务</view>

  <view class="empty" wx:if="{{errorText}}">{{errorText}}</view>
</view>
