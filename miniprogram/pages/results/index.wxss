.results-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 任务卡：分享按钮整行，内容水平垂直居中 */
.task-share-row {
  margin-top: 18rpx;
}

.share-btn {
  width: 100%;
  height: 72rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #126e6a, #0b4f4c);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  margin: 0;
}

.share-btn::after {
  border: none;
}

.share-btn__icon {
  position: relative;
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
}

.share-btn__arrow {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 6rpx;
  height: 16rpx;
  margin-left: -3rpx;
  border-radius: 3rpx;
  background: #ffffff;
}

.share-btn__arrow::before {
  content: "";
  position: absolute;
  top: -2rpx;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-top: 4rpx solid #ffffff;
  border-left: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

.share-btn__base {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 26rpx;
  height: 18rpx;
  margin-left: -13rpx;
  border: 4rpx solid #ffffff;
  border-radius: 3rpx 3rpx 0 0;
  border-bottom: none;
  box-sizing: border-box;
}

.share-btn__text {
  color: #ffffff;
  line-height: 1;
}

/* 任务卡：chips + 文件行 */
.meta-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 18rpx 0 22rpx;
}

.meta-chip {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #f2f6f7;
  color: #5a6771;
  font-size: 22rpx;
}

.meta-chip--safe {
  background: rgba(18, 110, 106, 0.1);
  color: #126e6a;
  font-weight: 600;
}

.meta-chip--warn {
  background: rgba(217, 119, 6, 0.12);
  color: #d97706;
  font-weight: 600;
}

.file-line {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.file-line + .file-line {
  margin-top: 14rpx;
}

.file-badge {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}

.file-badge--a {
  background: linear-gradient(135deg, #126e6a, #0b4f4c);
}

.file-badge--b {
  background: #7b8794;
}

.file-line__name {
  flex: 1;
  font-size: 24rpx;
  color: #44515c;
  word-break: break-all;
  line-height: 40rpx;
}

/* 相似度指标：总相似度 hero + 细分条 */
.metric-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f4faf9, #eef5f5);
  margin-bottom: 24rpx;
}

.metric-hero__score {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.05;
  color: #126e6a;
  font-variant-numeric: tabular-nums;
}

.metric-hero__score--warning {
  color: #d97706;
}

.metric-hero__score--danger {
  color: #d64545;
}

.metric-hero__side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.metric-hero__hint {
  color: #68727d;
  font-size: 22rpx;
}

.overview-bars {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bar-group-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #44515c;
}

.bar-group-title--alt {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eef2f4;
}

.bar-group-note {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #f2f6f7;
  color: #98a4ae;
  font-size: 20rpx;
  font-weight: 400;
}

.overview-bars .bar-row + .bar-row {
  margin-top: 10rpx;
}

.bar-row--struct .bar-row__label {
  color: #98a4ae;
}

.bar-row--struct .bar-row__value {
  color: #68727d;
}

.bar-row__fill--neutral {
  background: #aebac4;
}

.overview-stats {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.overview-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #f7fafb;
}

.overview-stat__value {
  font-size: 32rpx;
  font-weight: 700;
  color: #0b4f4c;
  font-variant-numeric: tabular-nums;
}

.overview-stat__label {
  font-size: 22rpx;
  color: #98a4ae;
}

.overview-note {
  margin-top: 20rpx;
  color: #98a4ae;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 结果列表与预览 */
.result-list,
.preview-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.preview-item {
  padding: 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e3ebef;
  background: #fbfcfd;
}

.preview-item__meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.preview-item__ratio {
  color: #126e6a;
  font-weight: 700;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
}

.preview-item__block {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
}

.preview-item__block--a {
  background: rgba(18, 110, 106, 0.06);
  border-left: 6rpx solid #126e6a;
}

.preview-item__block--b {
  background: #f4f6f7;
  border-left: 6rpx solid #a8b3bd;
}

.preview-item__label {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.preview-item__block--a .preview-item__label {
  background: #126e6a;
}

.preview-item__block--b .preview-item__label {
  background: #7b8794;
}

.preview-item__text {
  flex: 1;
  font-size: 24rpx;
  color: #44515c;
  line-height: 1.7;
  word-break: break-all;
}

.preview-item__pos {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.preview-item__pos-chip {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f6f7;
  color: #68727d;
  font-size: 20rpx;
}

/* 操作区 */
.result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.compare-cta {
  width: 100%;
}

.result-actions-row {
  display: flex;
  gap: 16rpx;
}

.result-actions-row button {
  flex: 1;
}

.result-order-no {
  margin-top: 16rpx;
  color: #98a4ae;
  font-size: 22rpx;
  text-align: center;
}

.footer-link {
  text-align: center;
  color: #98a4ae;
  font-size: 24rpx;
  padding: 8rpx 0 16rpx;
}
