.compare-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.picker-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d8e0e5;
  border-radius: 18rpx;
  background: #ffffff;
}

.doc-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.doc-actions button {
  flex: 1;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 24rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #d8e0e5;
  color: #68727d;
}

.filter-chip--active {
  background: #126e6a;
  border-color: #126e6a;
  color: #ffffff;
}

.compare-subtitle {
  margin-top: 24rpx;
}

.lock-btn {
  width: 100%;
  margin-top: 20rpx;
}

.lock-tip {
  margin-top: 16rpx;
  color: #44515c;
  font-size: 24rpx;
}

.preview-list,
.match-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-item,
.match-item {
  padding: 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8ec;
  background: #fbfcfd;
}

.match-item--active {
  border-color: #126e6a;
  box-shadow: 0 0 0 4rpx rgba(18, 110, 106, 0.08);
}

.preview-item__meta,
.match-item__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preview-item__ratio,
.match-item__ratio {
  color: #126e6a;
  font-weight: 600;
}

.preview-item__block,
.match-item__excerpt,
.match-item__pos,
.detail-meta {
  margin-top: 10rpx;
}

.preview-item__label,
.detail-label,
.detail-meta,
.match-item__pos {
  color: #68727d;
  font-size: 22rpx;
}

.match-item__title {
  margin-top: 10rpx;
  font-weight: 600;
}

.hit-overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.hit-overview__item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7fafb;
}

.hit-overview__label {
  display: block;
  color: #68727d;
  font-size: 22rpx;
}

.hit-overview__value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  word-break: break-all;
}

.detail-block + .detail-block {
  margin-top: 20rpx;
}

.detail-text {
  margin-top: 8rpx;
}

/* 格式相似项 */
.section-count {
  font-size: 24rpx;
  color: #98a2ad;
  font-weight: 400;
}

.format-list,
.metadata-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.format-item,
.metadata-item {
  padding: 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8ec;
  background: #fbfcfd;
}

.format-item__head,
.metadata-item__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.format-item__name,
.metadata-item__name {
  flex: 1;
  font-weight: 600;
}

.format-item__ratio {
  color: #126e6a;
  font-weight: 600;
}

.format-item__body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.format-item__row,
.metadata-item__row {
  display: flex;
  gap: 12rpx;
  align-items: baseline;
  font-size: 25rpx;
  color: #44515c;
  word-break: break-all;
}

.format-item__side,
.metadata-item__side {
  flex: none;
  width: 40rpx;
  text-align: center;
  padding: 2rpx 0;
  border-radius: 8rpx;
  background: #eef5f5;
  color: #126e6a;
  font-size: 22rpx;
  font-weight: 600;
}

.format-item__desc {
  margin-top: 10rpx;
  color: #98a2ad;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 元数据对比 */
.metadata-tag {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.meta-same {
  background: rgba(18, 110, 106, 0.1);
  color: #126e6a;
}

.meta-similar {
  background: rgba(217, 119, 6, 0.12);
  color: #d97706;
}

.meta-different {
  background: rgba(214, 69, 69, 0.1);
  color: #d64545;
}

.meta-missing {
  background: #eef1f4;
  color: #68727d;
}
