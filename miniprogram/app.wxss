page {
  background: #f5f7f8;
  color: #1f2933;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #dde3e7;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.section-desc {
  color: #68727d;
  font-size: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #126e6a, #0b4f4c);
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 30rpx;
}

.btn-secondary {
  background: #eef5f5;
  color: #126e6a;
  border-radius: 18rpx;
  border: 1rpx solid #c9dddd;
  font-size: 28rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #edf8f7;
  color: #126e6a;
}

.tag-danger {
  background: rgba(214, 69, 69, 0.1);
  color: #d64545;
}

.tag-warning {
  background: rgba(217, 119, 6, 0.12);
  color: #d97706;
}

.tag-safe {
  background: rgba(18, 110, 106, 0.1);
  color: #126e6a;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d8e0e5;
  border-radius: 18rpx;
  background: #ffffff;
  padding: 20rpx;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
}

.muted {
  color: #68727d;
}

.danger {
  color: #d64545;
}

.empty {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #68727d;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions button {
  flex: 1;
}

/* ===== 通用布局工具 ===== */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge--promo {
  background: linear-gradient(135deg, #ff8a00, #f04b2a);
  color: #ffffff;
}

.badge--plain {
  background: #eef5f5;
  color: #126e6a;
}

.price-strike {
  color: #98a2ad;
  font-size: 24rpx;
  text-decoration: line-through;
}

.price-highlight {
  color: #f04b2a;
  font-weight: 700;
}

.price-save {
  color: #126e6a;
  font-weight: 600;
}

/* ===== 进度条（相似度可视化） ===== */
.bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.bar-row__label {
  flex: 0 0 140rpx;
  color: #68727d;
  font-size: 24rpx;
}

.bar-row__track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: #eef2f4;
  overflow: hidden;
}

.bar-row__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #23b3a4, #126e6a);
  transition: width 0.4s ease;
}

.bar-row__fill--danger {
  background: linear-gradient(90deg, #ffb199, #f04b2a);
}

.bar-row__fill--warning {
  background: linear-gradient(90deg, #ffd08a, #f59e0b);
}

.bar-row__value {
  flex: 0 0 96rpx;
  text-align: right;
  font-weight: 600;
  font-size: 24rpx;
}

/* ===== 通知条 ===== */
.notice-strip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  border: 1rpx solid #fde3c1;
  color: #9a5b13;
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-strip--info {
  background: #eff8fb;
  border-color: #cde7f1;
  color: #155e75;
}

.notice-strip--success {
  background: #edf8f7;
  border-color: #c4e7e3;
  color: #126e6a;
}

/* ===== 复制任务号胶囊 ===== */
.task-id-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f2f7f7;
  border: 1rpx dashed #9ecbc6;
}

.task-id-box__text {
  flex: 1;
  min-width: 0;
  font-family: monospace;
  font-size: 24rpx;
  font-weight: 700;
  color: #0b4f4c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-id-box__copy {
  flex: none;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #126e6a;
  color: #ffffff;
  font-size: 24rpx;
}
