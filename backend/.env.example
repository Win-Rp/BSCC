# 统一公网基准地址（可选）
# 当后台未单独填写支付宝/微信异步通知地址时，会自动拼接：
# 支付宝 => {SITE_BASE_URL}/api/payments/alipay/notify
# 微信   => {SITE_BASE_URL}/api/payments/wechat/notify
SITE_BASE_URL=https://your-domain.com

# 支付宝配置
# 你的应用 ID (App ID)
ALIPAY_APP_ID=你的APP_ID

# 你的应用私钥 (确保为单行或标准 PEM 格式，如果不包含 -----BEGIN PRIVATE KEY-----，python-alipay-sdk 会自动处理，但建议使用标准格式)
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n你的私钥内容...\n-----END PRIVATE KEY-----"

# 支付宝公钥 (用于验签)
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n支付宝公钥内容...\n-----END PUBLIC KEY-----"

# 支付宝异步通知的公网访问地址 (使用内网穿透工具，如 ngrok 或 natapp 获取的地址)
ALIPAY_NOTIFY_URL=http://你的公网域名/api/payments/alipay/notify

# 微信 Native 支付配置
WECHATPAY_ENABLED=False
WECHATPAY_APP_ID=你的微信APPID
WECHATPAY_MCH_ID=你的微信商户号
WECHATPAY_API_V2_KEY=你的微信支付APIv2Key
WECHATPAY_NOTIFY_URL=http://你的公网域名/api/payments/wechat/notify
